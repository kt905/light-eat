# 百度AI开放平台配置
# 前往 https://console.bce.baidu.com/ai/#/ai/imagerecognition/app/list 创建应用
# 启用「图像识别」→「菜品识别」能力
BAIDU_API_KEY=your_api_key_here
BAIDU_SECRET_KEY=your_secret_key_here

# 服务端口
PORT=3000

# CORS 允许的来源（多个用逗号分隔，留空则默认允许 localhost）
# CORS_ORIGIN=http://localhost:3000,http://localhost:5500

# 是否启用模拟模式（未配置API Key时自动开启）
# MOCK_MODE=true